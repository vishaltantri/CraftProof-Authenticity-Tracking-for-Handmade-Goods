# CraftProof backend — local development environment.
#
#   cp .env.local.example .env.local      and fill in the real values
#   uvicorn main:app --port 8002 --env-file .env.local
#
# .env.local is git-ignored. NEVER commit real keys: put deployed values in
# the Render dashboard instead, where render.yaml marks them `sync: false`.

# --- required -----------------------------------------------------------------
# At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# --- ReMarket marketplace integration (backend/remarket.py) -------------------
# The partner's base URL and the sale API key they shared with you. The key is
# used only server-side; it is never sent to the browser or stored in the DB.
REMARKET_API_URL=https://remarket-24rz.onrender.com
REMARKET_SALE_API_KEY=ask-the-remarket-team-for-this

# A DIFFERENT secret, gating POST /integrations/remarket/sync. Keeping these
# separate means whoever may trigger a sync is not handed the partner's key.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRAFTPROOF_REMARKET_SYNC_KEY=replace-with-another-random-secret

# Seconds between background polls; 0 turns the poller off (handy locally).
REMARKET_SYNC_INTERVAL_SECONDS=300

# Where the integration's Ed25519 signing key lives. Keep it OFF the database
# volume so a stolen database alone cannot mint imported custody records.
CRAFTPROOF_REMARKET_KEY=integration/remarket_signer.key
